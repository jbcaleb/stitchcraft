<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Name and Publisher are placeholders until there is a Store listing or a real
       code-signing certificate: Publisher must then match that certificate's subject
       (and scripts/sign-msix-test.ps1 must be kept in step with it). -->
  <Identity
    Name="jbcaleb.Stitchcraft"
    Publisher="CN=2F6A3C8E-9B41-4D7A-8E5C-1A7B90D4C3E2"
    Version="__VERSION__"
    ProcessorArchitecture="__ARCH__" />

  <Properties>
    <DisplayName>Stitchcraft</DisplayName>
    <PublisherDisplayName>jbcaleb</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Stitchcraft" Executable="stitchcraft.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Stitchcraft"
        Description="Build Minecraft mods for Fabric and NeoForge by snapping blocks together"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
